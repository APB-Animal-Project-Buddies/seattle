{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "nhost",
    "functions",
    "recipes",
    "scripts",
    // Backend submodule: only scripts/lib is imported by the app (the projects sync
    // core). The rest is Nhost config, email templates and Bun CLIs that this
    // tsconfig's target can't compile and doesn't need to.
    "backend_migrations/nhost",
    "backend_migrations/scripts/sync-projects-from-sheet.ts"
  ]
}
